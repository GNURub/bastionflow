# Local testing defaults. Change these before exposing anything outside localhost.
CROWDSEC_BOUNCER_API_KEY=local-traefik-bouncer-key-change-me
CROWDSEC_DASHBOARD_MACHINE_PASSWORD=local-dashboard-machine-password-change-me

PORT=8080
TRAEFIK_API_INSECURE=false

# Comma-separated free GeoIP fallbacks. Set to none to disable external lookups. Results are cached in SQLite.
CROWDSEC_GEOIP_LOOKUP_URLS=https://ipwho.is/{ip},https://ipapi.co/{ip}/json/,https://free.freeipapi.com/api/json/{ip},https://api.ipwho.org/ip/{ip},http://ip-api.com/json/{ip}

# Internal token used by the background notification worker to dispatch events. Change before exposing anything.
CROWDSEC_INTERNAL_TOKEN=local-internal-token-change-me
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_WORKER_MIN_SEVERITY=info
CROWDSEC_ALLOW_INSECURE_WEBHOOKS=false
CROWDSEC_ALLOW_PRIVATE_WEBHOOKS=false
# Optional seed channels on first start, JSON array. URLs are stored in SQLite and masked in the API/UI.
# CROWDSEC_NOTIFICATION_CHANNELS=[{"name":"secops-slack","type":"slack","url":"https://hooks.slack.com/services/...","enabled":true,"minSeverity":"high"}]

# Edge gate for protected apps: browser challenge and optional password challenge.
EDGE_GATE_ENABLED=true
EDGE_GATE_BOT_CHALLENGE_ENABLED=true
EDGE_GATE_AUTH_ENABLED=true
EDGE_GATE_PASSWORD=local-edge-gate-password-change-me
EDGE_GATE_COOKIE_SECRET=local-edge-gate-secret-change-me
